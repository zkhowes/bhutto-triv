generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Authentication & Users ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Profile fields
  nickname        String?
  phoneNumber     String?
  timezone        String  @default("America/Los_Angeles")
  avatarUrl       String?
  profileComplete Boolean @default(false)

  // Super admin
  isSuperAdmin Boolean @default(false)

  // Notification preference override (null = use league setting)
  notificationPreference String? // "none" | "low" | "high"

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt     DateTime?
  lastSeenWhatsNew DateTime?

  // Relations
  accounts         Account[]
  sessions         Session[]
  leaguePlayers    LeaguePlayer[]
  questionsCreated Question[]
  roundAnswers     RoundAnswer[]
  notifications    Notification[]
  questionDrafts   QuestionDraft[]
}

// ─── League Structure ───────────────────────────────────────────────────

model League {
  id               String    @id @default(cuid())
  name             String
  type             String    @default("season") // "single", "season", "test"
  inviteCode       String    @unique
  isActive         Boolean   @default(true)
  deactivatedAt    DateTime?
  deactivateReason String?

  // Settings
  gamesPerSeason        Int     @default(10)
  maxPlayers            Int     @default(10)
  dailyDeadline         String  @default("10:00") // HH:mm format
  deadlineTimezone      String  @default("America/Los_Angeles")
  submissionWindowStart String  @default("17:00")
  submissionWindowEnd   String  @default("07:00")
  categoryRevealTime    String  @default("07:00")
  answerTimerSeconds    Int     @default(120) // Timer from category reveal to answer deadline
  absenteePenaltyType   String  @default("half") // "half", "quarter", "none"
  autoSkipEnabled       Boolean @default(true) // Auto-skip at-bat players after 27h of inactivity
  notificationMode      String  @default("low") // "none" | "low" | "high"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  players          LeaguePlayer[]
  seasons          Season[]
  shareableLinks   ShareableLink[]
  customCategories LeagueCategory[]
}

model LeaguePlayer {
  id           String  @id @default(cuid())
  leagueId     String
  userId       String
  role         String  @default("player") // "commissioner", "player"
  isActive     Boolean @default(true)
  isPaused     Boolean @default(false) // Temporarily removed from active play; history preserved
  isFake       Boolean @default(false) // For test mode
  fakeNickname String? // For test mode fake players

  joinedAt  DateTime  @default(now())
  pausedAt  DateTime?
  removedAt DateTime?

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  battingOrderEntries BattingOrderEntry[]
  gamePlayerStates    GamePlayerState[]
  roundAnswers        RoundAnswer[]
  questionsCreated    Question[]
  flagReviews         FlagReview[]
  flagVotes           FlagVote[]

  @@unique([leagueId, userId])
}

// ─── Season & Game Structure ────────────────────────────────────────────

model Season {
  id       String @id @default(cuid())
  leagueId String
  number   Int // Season number (1, 2, 3...)
  status   String @default("pending") // "pending", "active", "paused", "completed"

  startedAt   DateTime?
  completedAt DateTime?
  pausedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  league League        @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  games  Game[]
  awards SeasonAward[]

  @@unique([leagueId, number])
}

model Game {
  id          String @id @default(cuid())
  seasonId    String
  number      Int // Game number within season
  status      String @default("pending") // "pending", "active", "completed"
  totalRounds Int    @default(0) // Set at creation = player count, decremented on cancel

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season       Season              @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  rounds       Round[]
  battingOrder BattingOrderEntry[]
  playerStates GamePlayerState[]
  flagReviews  FlagReview[]

  @@unique([seasonId, number])
}

model GamePlayerState {
  id             String  @id @default(cuid())
  gameId         String
  leaguePlayerId String
  points         Int     @default(20) // Betting points
  startingPoints Int     @default(20) // Points this player started the game with (20 + carryover bonus)
  totalF1Points  Int     @default(0) // Accumulated F1 scoring points
  skipCount      Int     @default(0) // Cumulative skips this game
  isEliminated   Boolean @default(false)
  bonusEarned    Int     @default(0) // +1 per correct answer while busted; carries to next game in same season
  flagUsed       Boolean @default(false) // One challenge flag per game
  blindBetUsed   Boolean @default(false) // One blind bet per game

  game         Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  leaguePlayer LeaguePlayer @relation(fields: [leaguePlayerId], references: [id], onDelete: Cascade)

  @@unique([gameId, leaguePlayerId])
}

model BattingOrderEntry {
  id             String @id @default(cuid())
  gameId         String
  leaguePlayerId String
  position       Int // 0-indexed position in batting order

  game         Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  leaguePlayer LeaguePlayer @relation(fields: [leaguePlayerId], references: [id], onDelete: Cascade)

  @@unique([gameId, leaguePlayerId])
  @@unique([gameId, position])
}

// ─── Round & Questions ──────────────────────────────────────────────────

model Round {
  id          String  @id @default(cuid())
  gameId      String
  number      Int // Round number within game
  status      String  @default("pending")
  // "pending" | "awaiting_question" | "question_submitted" | "category_revealed" | "graded" | "under_review" | "cancelled"
  isCancelled Boolean @default(false)

  atBatPlayerId     String? // LeaguePlayer id of player creating question
  onDeckPlayerId    String? // Next player
  inTheHolePlayerId String? // Player after next
  skippedPlayerId   String? // LeaguePlayer id of skipped player (for revert)
  skipPenaltyAmount Int?    // Points deducted on 2nd skip (for revert)

  questionSubmissionOpensAt DateTime?
  categoryRevealAt          DateTime?
  deadlineAt                DateTime?

  funFact           String? // AI-generated "Did You Know" fact
  questionComposite Float? // Computed question quality score (1-5 scale)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game       Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  question   Question?
  answers    RoundAnswer[]
  flagReview FlagReview?

  @@unique([gameId, number])
}

model Question {
  id             String  @id @default(cuid())
  roundId        String? @unique
  leaguePlayerId String
  creatorUserId  String

  category     String // Geography, Sports, etc.
  questionText String
  answerFormat String // "multiple_choice" or "free_text"

  // Multiple choice
  optionA       String?
  optionB       String?
  optionC       String?
  optionD       String?
  correctOption String? // "A", "B", "C", or "D"

  // Free text
  correctAnswer     String?
  acceptableAnswers String? // JSON array of acceptable variations
  correctAnswerUnit String? // Closest-guess only: unit shown to answerers (e.g. "miles", "tons")

  // Image attachment (optional)
  imageUrl         String?
  imageSource      String?   // "unsplash" | "google" | "upload" | "url"
  imageAttribution String?   // JSON: {"name":"...","profileUrl":"..."} for Unsplash

  isEditable         Boolean @default(true) // Locked once first bet placed
  isFromBank         Boolean @default(false)
  isReplay           Boolean @default(false)
  originalQuestionId String?

  // Ordering format
  orderingItems        String?   // JSON: ["Brazil","India","China","USA"]
  orderingCorrectOrder String?   // JSON: [1,2,3,4] (correct position per item)
  orderingDirection    String?   // e.g. "most to least", "earliest to latest"
  orderingItemValues   String?   // JSON: parallel to orderingItems, comparable scalars (years, populations); equal values count as ties when scoring

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  round        Round?        @relation(fields: [roundId], references: [id])
  leaguePlayer LeaguePlayer  @relation(fields: [leaguePlayerId], references: [id])
  creator      User          @relation(fields: [creatorUserId], references: [id])
  answers      RoundAnswer[]
  reviewLogs   QuestionReviewLog[]
}

// Forensic log of the at-submit reviewer agent's pass on each question.
// One row per submission attempt, capturing the AI/submitter payload before
// review and the final (possibly corrected) payload that hit production.
model QuestionReviewLog {
  id           String   @id @default(cuid())
  questionId   String
  format       String   // "multiple_choice" | "price_is_right" | "ordering"
  category     String
  questionText String
  beforeJson   String   // serialized payload pre-review
  afterJson    String   // serialized payload post-review (may equal before)
  changed      Boolean  // did the reviewer rewrite anything?
  notes        String?  // reviewer's free-text rationale
  modelUsed    String   // e.g. "claude-haiku-4-5-20251001"
  status       String   // "ok" | "review_unavailable" | "review_error"
  latencyMs    Int
  createdAt    DateTime @default(now())

  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuestionDraft {
  id                String  @id @default(cuid())
  userId            String
  category          String?
  questionText      String?
  answerFormat      String?
  optionA           String?
  optionB           String?
  optionC           String?
  optionD           String?
  correctOption     String?
  correctAnswer     String?
  acceptableAnswers String?
  correctAnswerUnit String?
  imageUrl         String?
  imageSource      String?
  imageAttribution String?
  orderingItems        String?
  orderingCorrectOrder String?
  orderingDirection    String?
  orderingItemValues   String?
  useOnNextRound    Boolean @default(false)
  leagueId          String? // If associated with specific league

  isReplay           Boolean @default(false)
  originalQuestionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Answers & Grading ──────────────────────────────────────────────────

model RoundAnswer {
  id             String @id @default(cuid())
  roundId        String
  questionId     String
  leaguePlayerId String
  userId         String

  // Betting
  betAmount   Int?
  betPlacedAt DateTime?

  // Answer
  selectedOption String? // For multiple choice: "A", "B", "C", "D"
  freeTextAnswer String? // For free text
  answeredAt     DateTime?

  // Grading
  isCorrect        Boolean?
  gradedBy         String? // "auto", "ai", "creator", "commissioner"
  aiGradeCorrect   Boolean? // What AI graded (before creator override)
  creatorValidated Boolean  @default(false)

  // Scoring
  pointsWon  Int     @default(0) // Positive for win, negative for loss
  f1Points   Int     @default(0) // F1 placement points
  placement  Int? // 1st, 2nd, etc.
  fastestLap Boolean @default(false)

  // Power-ups
  powerUpType String? // "hint" | "elimination" | "highlow"
  powerUpCost Int     @default(0)
  powerUpData String? // JSON: { hint?, eliminatedOption?, probeValue?, direction? }

  // Cheat Seeker (client-side signals collected during answering)
  cheatSeekerData String? // JSON: { tabSwitches, timeAway, pasteDetected, blurCount }

  // Question quality rating (1-5 stars)
  questionRating Int?

  // Absentee
  isAbsent Boolean @default(false)
  isBlindBet     Boolean @default(false) // Whether this bet was placed blind (2x multiplier)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  round        Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  question     Question     @relation(fields: [questionId], references: [id])
  leaguePlayer LeaguePlayer @relation(fields: [leaguePlayerId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([roundId, leaguePlayerId])
}

// ─── Awards & Stats ─────────────────────────────────────────────────────

model SeasonAward {
  id        String @id @default(cuid())
  seasonId  String
  awardType String // "mvp", "iron_man", "offensive", "defensive", "comeback", "rookie", "clutch", "strategist", "most_improved"
  playerId  String // LeaguePlayer id
  stat      String // Relevant statistic description
  value     Float? // Numeric value if applicable

  createdAt DateTime @default(now())

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
}

// ─── Notifications ──────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  leagueId  String?
  gameId    String?
  roundId   String?
  type      String // "at_bat" | "new_question" | "all_answers_in" | "on_deck" | "round_results" | "about_to_be_skipped"
  title     String
  message   String
  link      String? // click-through URL (/api/notifications/click/[id] → actual page)
  data      String? // JSON with additional context
  isRead    Boolean   @default(false)
  smsStatus String? // null (in-app only) | "sent" | "failed"
  smsSentAt DateTime?
  clickedAt DateTime? // set when player clicks the notification link

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Shareable Links ────────────────────────────────────────────────────

model ShareableLink {
  id        String  @id @default(cuid())
  leagueId  String
  type      String // "invitation", "round", "game", "season", "league"
  token     String  @unique
  entityId  String? // ID of the round/game/season being shared
  isActive  Boolean @default(true)
  viewCount Int     @default(0)

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
}

// ─── Global Settings ────────────────────────────────────────────────────

model GlobalSettings {
  id                   String   @id @default("singleton")
  notificationOverride String   @default("commissioner") // "none" | "commissioner"
  updatedAt            DateTime @updatedAt
}

// ─── Admin Sessions ─────────────────────────────────────────────────────

model AdminSession {
  id        String   @id @default(cuid())
  userId    String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── League Categories ──────────────────────────────────────────────────

model LeagueCategory {
  id          String   @id @default(cuid())
  leagueId    String
  name        String
  createdById String // LeaguePlayer id who first used it
  usageCount  Int      @default(1)
  createdAt   DateTime @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([leagueId, name])
}

// ─── Admin Audit Log ────────────────────────────────────────────────────

model AdminAuditLog {
  id         String  @id @default(cuid())
  adminId    String // User id of admin
  action     String // Description of action taken
  entityType String? // "league", "player", "question"
  entityId   String?

  createdAt DateTime @default(now())
}

// ─── Flag Reviews (Challenge System) ─────────────────────────────────

model FlagReview {
  id          String    @id @default(cuid())
  roundId     String    @unique
  gameId      String
  flaggedById String // LeaguePlayer who threw the flag
  objection   String // Plain text reason for contesting
  status      String    @default("pending") // "pending" | "agreed" | "disagreed"
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  round     Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  game      Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  flaggedBy LeaguePlayer @relation(fields: [flaggedById], references: [id])
  votes     FlagVote[]
}

model FlagVote {
  id             String   @id @default(cuid())
  flagReviewId   String
  leaguePlayerId String
  vote           String // "agree" | "disagree"
  isProxyVote    Boolean  @default(false) // Commissioner voted on behalf
  createdAt      DateTime @default(now())

  flagReview   FlagReview   @relation(fields: [flagReviewId], references: [id], onDelete: Cascade)
  leaguePlayer LeaguePlayer @relation(fields: [leaguePlayerId], references: [id])

  @@unique([flagReviewId, leaguePlayerId])
}
