# Database
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-in-production"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Apple OAuth (Sign in with Apple)
# APPLE_ID = Service ID from Apple Developer (e.g. fun.zkhowes.bwiz.auth)
# APPLE_SECRET = Generated JWT client secret (see scripts/generate-apple-secret.js)
APPLE_ID=
APPLE_SECRET=

# Anthropic AI
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Super Admin
SUPER_ADMIN_PASSWORD="your-super-admin-password"

# Mosio SMS (leave blank to disable SMS, use in-app notifications only)
MOSIO_API_KEY=
MOSIO_FROM_NUMBER=

# Vercel Cron Security
CRON_SECRET=your-random-cron-secret

# App Config
NODE_ENV="development"
/